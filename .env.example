# FitLife 环境变量样例（P1 密钥外置）
# 用法：复制为 .env 后填入真实值；start-fitlife.ps1 与 scripts/p1-oneclick.ps1 会自动加载。
# 注意：.env 已在 .gitignore 中，请勿提交。

# ---- 必填：JWT 签名密钥（>= 32 字节，建议随机生成）----
# 生成方式（PowerShell）：
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# ---- 数据库（未设置时走 application-local.yml 的本地默认值）----
DB_USER=root
DB_PASS=888
# 如需指向远程库，可整体覆盖连接串：
# DB_URL=jdbc:mysql://localhost:3306/fitlife?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# ---- 大模型服务商（按需填写，留空则该厂商不可用）----
DEEPSEEK_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=

# ---- 可选：默认模型与限流 ----
# AI_DEFAULT_MODEL=deepseek-chat
# AI_RATE_LIMIT=30

# ---- 可选：CORS 允许来源（逗号分隔，默认 * 便于本地开发）----
# CORS_ORIGINS=http://localhost:5173

# ---- 可选：日志级别 ----
# LOG_LEVEL_FITLIFE=INFO
# LOG_LEVEL_SECURITY=WARN