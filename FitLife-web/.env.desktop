# ============================================================
# 桌面版构建参数（npm run build:desktop 时自动加载）
# 产物会被拷贝到 FitLife-java/src/main/resources/static 并打进 jar
# ============================================================

# 内嵌静态资源没有服务端 rewrite，必须用 hash 路由
VITE_ROUTER_MODE=hash

# 前端与后端同源部署，接口一律走相对路径
VITE_APP_API_URL=/api

# 输出目录
VITE_OUT_DIR=dist

# 不生成 sourcemap（减小安装包体积）
VITE_SOURCEMAP=0
